{
  "name": "muclaude",
  "productName": "MuClaude",
  "version": "2.5.1",
  "description": "Run several Claude Desktop accounts side by side (macOS and Windows).",
  "main": "src/main/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.js",
    "predev": "npm run build:login-router",
    "prestart": "npm run build:login-router",
    "start": "electron .",
    "test": "node scripts/test-core.js && node --test scripts/test-code.js scripts/test-google-login.js scripts/test-menubar.js",
    "build:login-router": "node scripts/build-login-router.js",
    "test:google-native": "node scripts/test-google-native.js",
    "test:menubar-ui": "electron scripts/test-menubar-ui.js",
    "icons:menubar": "electron scripts/make-menubar-icons.js",
    "test:google-ui": "electron scripts/test-google-ui.js",
    "install:cli": "node scripts/install-code-cli.js",
    "icons": "electron scripts/make-icons.js",
    "screenshots": "electron scripts/shot-main.js docs-shots",
    "dist:mac": "electron-builder --mac && codesign --verify --deep --strict \"dist/mac-arm64/MuClaude.app\"",
    "install:mac": "bash scripts/install-mac.sh",
    "dist:win": "electron-builder --win",
    "selfcheck": "electron . --self-check",
    "test:code-ui": "electron scripts/test-code-ui.js"
  },
  "build": {
    "beforePack": "scripts/before-pack.js",
    "appId": "com.muclaude.app",
    "productName": "MuClaude",
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "extendInfo": { "LSUIElement": true },
      "icon": "build/icon.icns",
      "identity": "-",
      "extraResources": [
        { "from": "build/login-router/MuClaude Login Router.app", "to": "MuClaude Login Router.app" }
      ],
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "npmRebuild": false,
    "asar": true,
    "extraResources": [
      { "from": "src/code", "to": "code-cli" }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "dmg": {
      "title": "MuClaude",
      "icon": "build/icon.icns"
    }
  },
  "devDependencies": {
    "@electron/asar": "^3.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "author": "MuClaude",
  "allowScripts": {
    "electron-winstaller": false,
    "electron@44.5.1": true
  }
}
